# Story-beat-writer config. Copy to .env and edit.
# Path to session root (containing realm/character/session-N/session-N.jsonl)
PATH_TO_SESSIONS=/path/to/sessions
REALM=ExampleRealm
CHARACTER_NAME=ExampleHero
SESSION=01

# Leave unset. A Burning Crusade Wowhead URL is refused so Forever quest ids
# are not filled with TBC quest text. This repo has no Forever quest catalog.
# WOWHEAD_QUEST_BASE_URL=
